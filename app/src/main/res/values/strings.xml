    <string name="perf_settings_desc">Make SpirOS lighter and faster on this phone</string>
    <string name="perf_intro">Options that reduce memory, CPU and battery use. Defaults are already tuned for mid-range phones.</string>
    <string name="perf_space">Isolated space</string>
    <string name="perf_no_space">No isolated space yet.</string>
