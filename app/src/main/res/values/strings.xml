    <string name="linux_start">Start the desktop</string>
    <string name="linux_stop">Shut down Linux</string>
    <string name="linux_touch_help">Tap = click · Long press = right click · Drag = move/select · ⇞ ⇟ = scroll · Type in the bar at the top. For a full keyboard inside Linux: Applications › Accessibility › Onboard. Turn the phone sideways for a wider desktop.</string>
    <string name="linux_type_hint">Type to Linux</string>
