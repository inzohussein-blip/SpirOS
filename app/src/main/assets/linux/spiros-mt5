#!/bin/sh
# MetaTrader 5 on SpirOS Linux. ARM64 phones: "MetaTrader 5 full" (downloaded by
# SpirOS into /opt/spiros-mt5: Hangover + MT5) opens straight away. x86-64: the first
# run downloads Wine and the official MT5 installer from MetaQuotes.
set -u
WINE_URL="https://github.com/Kron4ek/Wine-Builds/releases/download/10.20/wine-10.20-staging-amd64-wow64.tar.xz"
MT5_URL="https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe"
BASE="$HOME/.local/share/spiros"
WINEDIR="$BASE/wine"
export WINEPREFIX="$BASE/mt5"
export WINEDEBUG=-all WINEARCH=win64
mkdir -p "$BASE"
LOG="$BASE/mt5.log"

FULL=/opt/spiros-mt5
# "MetaTrader 5 full" for ARM64: Hangover (Wine for ARM64, x86-64 code through FEX).
HWINE=$(find "$FULL/hangover" -path '*bin/wine' -type f 2>/dev/null | head -n 1)
if [ -f "$FULL/.ready" ] && [ -n "$HWINE" ]; then
    export WINEPREFIX="$FULL/prefix"
    cd "$WINEPREFIX/drive_c/MT5" || exit 1
    echo "$(date) start MT5 (Hangover)" >> "$LOG"
    exec "$HWINE" terminal64.exe /portable >> "$LOG" 2>&1
fi

# ARM64 runs MT5 only through the full package (MT5's protection rejects Box64).
if [ "$(uname -m)" = aarch64 ]; then
    MSG="Open MetaTrader 5 from SpirOS: it downloads MetaTrader 5 full, then opens it."
    if [ -t 1 ]; then echo "$MSG"; else lxterminal -t "MetaTrader 5" -e sh -c "echo '$MSG'; read x"; fi
    exit 1
fi

# Opened directly (from SpirOS or a shortcut) before MT5 is set up: show the progress
# in a terminal window. Once installed, MT5 opens straight away.
if [ ! -t 1 ] && [ -z "${SPIROS_IN_TERM:-}" ] &&
   { [ ! -x "$WINEDIR/bin/wine" ] || [ -z "$(find "$WINEPREFIX/drive_c" -iname terminal64.exe 2>/dev/null | head -n 1)" ]; }; then
    exec lxterminal -t "MetaTrader 5" -e env SPIROS_IN_TERM=1 spiros-mt5
fi

if [ ! -x "$WINEDIR/bin/wine" ]; then
    echo "== Downloading Wine (one time) =="
    mkdir -p "$WINEDIR.part"
    if ! curl -fL --progress-bar "$WINE_URL" | tar -xJ -C "$WINEDIR.part" --strip-components=1; then
        echo "Download failed. Check the connection and open MetaTrader 5 again."; rm -rf "$WINEDIR.part"; read -r _; exit 1
    fi
    rm -rf "$WINEDIR"; mv "$WINEDIR.part" "$WINEDIR"
fi
WINE="$WINEDIR/bin/wine"

TERMINAL=$(find "$WINEPREFIX/drive_c" -iname terminal64.exe 2>/dev/null | head -n 1)
if [ -z "$TERMINAL" ]; then
    echo "== Preparing the Windows environment (one time, a few minutes) =="
    "$WINE" wineboot -u
    # MT5's protection takes Wine's crash handler (AeDebug) for a debugger.
    "$WINE" reg delete 'HKLM\Software\Microsoft\Windows NT\CurrentVersion\AeDebug' /v Debugger /f
    echo "== Downloading the MetaTrader 5 installer =="
    curl -fL --progress-bar -o "$BASE/mt5setup.exe" "$MT5_URL" || { echo "Download failed."; read -r _; exit 1; }
    echo "== Installing MetaTrader 5: follow the installer window =="
    "$WINE" "$BASE/mt5setup.exe"
    TERMINAL=$(find "$WINEPREFIX/drive_c" -iname terminal64.exe 2>/dev/null | head -n 1)
    [ -n "$TERMINAL" ] || { echo "MT5 was not installed."; read -r _; exit 1; }
fi
echo "== Starting MetaTrader 5 =="
exec "$WINE" "$TERMINAL"
