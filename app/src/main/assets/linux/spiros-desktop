#!/bin/sh
# Starts the SpirOS Linux desktop: an Xvnc server on a private Unix socket (no TCP
# port) and the system's desktop (Xfce, MATE or Cinnamon), as whichever account
# SpirOS started it with. A custom system without a desktop gets one installed
# automatically on first start (Debian/Ubuntu-based images, as root).
# SpirOS copies this script into the Linux system before every start (single source:
# app/src/main/assets/linux/spiros-desktop).
#   SPIROS_GEOMETRY  screen size, e.g. 1280x720
#   SPIROS_DPI       font DPI (larger = bigger UI for touch)
#   SPIROS_LIGHT     1 = light mode: no compositing effects, wireframe window
#                    moves, no power manager / screensaver / accessibility bus
#   SPIROS_SESSION   "desktop" (full Xfce) or "app" (one program, no desktop)
#   SPIROS_APP       the program for app mode (e.g. xfce4-terminal)
export DISPLAY=:1
export HOME="${HOME:-/root}"
export USER="${USER:-$(id -un)}"
export LANG="${LANG:-C.UTF-8}"
export XDG_RUNTIME_DIR="/tmp/runtime-$USER"
export NO_AT_BRIDGE=1
mkdir -p "$XDG_RUNTIME_DIR" /tmp/.X11-unix "$HOME"
chmod 700 "$XDG_RUNTIME_DIR"
chmod 1777 /tmp/.X11-unix 2>/dev/null
rm -f /tmp/.X1-lock /tmp/.X11-unix/X1 /tmp/spiros-vnc
cd "$HOME" || cd /

# ---- which desktop ----
DESKTOP=$(cat /etc/spiros-desktop 2>/dev/null)
if [ -z "$DESKTOP" ]; then
    if command -v tint2 >/dev/null && command -v openbox >/dev/null; then DESKTOP=spiros
    elif command -v cinnamon-session >/dev/null; then DESKTOP=cinnamon
    elif command -v mate-session >/dev/null; then DESKTOP=mate
    elif command -v xfce4-session >/dev/null; then DESKTOP=xfce
    fi
fi

# ---- custom system: install what the desktop needs on first start ----
if ! command -v Xvnc >/dev/null || [ -z "$DESKTOP" ]; then
    echo "SpirOS: this system has no desktop yet; installing Xfce + TigerVNC (one time)…"
    if [ "$(id -u)" != 0 ]; then
        echo "SpirOS: run the desktop as root once (Settings > Linux accounts) so it can be installed."
        exit 1
    fi
    if ! command -v apt-get >/dev/null; then
        echo "SpirOS: automatic setup needs a Debian or Ubuntu based system (apt-get)."
        exit 1
    fi
    [ -s /etc/resolv.conf ] || printf 'nameserver 9.9.9.9\nnameserver 1.1.1.1\n' > /etc/resolv.conf
    mkdir -p /usr/sbin && printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d && chmod +x /usr/sbin/policy-rc.d
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        tigervnc-standalone-server dbus-x11 xfce4 xfce4-terminal fonts-noto-core || exit 1
    [ -z "$DESKTOP" ] && DESKTOP=xfce && echo xfce > /etc/spiros-desktop
    echo "SpirOS: desktop installed."
fi

# ---- light mode (Settings > Performance & battery) ----
CONF="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml"
mkdir -p "$CONF" "$HOME/.config/autostart"
if [ "${SPIROS_LIGHT:-1}" = 1 ]; then ON=false; else ON=true; fi
if [ -f "$CONF/xfwm4.xml" ] && grep -q use_compositing "$CONF/xfwm4.xml"; then
    sed -i "s/\(name=\"use_compositing\" type=\"bool\" value=\"\)[a-z]*/\1$ON/" "$CONF/xfwm4.xml"
elif [ ! -f "$CONF/xfwm4.xml" ]; then
    cat > "$CONF/xfwm4.xml" <<XML
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="use_compositing" type="bool" value="$ON"/>
    <property name="box_move" type="bool" value="true"/>
    <property name="box_resize" type="bool" value="true"/>
  </property>
</channel>
XML
fi
for a in xfce4-power-manager xscreensaver xfce4-screensaver light-locker at-spi-dbus-bus xiccd blueman nm-applet; do
    if [ "${SPIROS_LIGHT:-1}" = 1 ]; then
        printf '[Desktop Entry]\nType=Application\nName=%s\nHidden=true\n' "$a" > "$HOME/.config/autostart/$a.desktop"
    else
        rm -f "$HOME/.config/autostart/$a.desktop"
    fi
done
[ "${SPIROS_LIGHT:-1}" = 1 ] && export GTK_A11Y=none

# SpirOS Linux is drawn for touch: slightly larger text than a desktop.
if [ "$DESKTOP" = spiros ] && [ "${SPIROS_DPI:-120}" -lt 140 ]; then SPIROS_DPI=140; fi

# Cinnamon needs OpenGL: on a phone it is drawn by the CPU (Mesa llvmpipe).
if [ "$DESKTOP" = cinnamon ]; then
    export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe
    GLX="+extension GLX"
fi

Xvnc :1 \
    -geometry "${SPIROS_GEOMETRY:-1280x720}" -depth 24 -dpi "${SPIROS_DPI:-120}" \
    -rfbport -1 -rfbunixpath /tmp/spiros-vnc -rfbunixmode 0600 \
    -SecurityTypes None -AlwaysShared -nolisten tcp -FrameRate "${SPIROS_FPS:-30}" ${GLX:-} &

# Wait for the X server before starting the session.
i=0
while [ ! -S /tmp/.X11-unix/X1 ] && [ $i -lt 50 ]; do sleep 0.2; i=$((i + 1)); done

# ---- single-app mode: one program and a window manager, no desktop ----
if [ "${SPIROS_SESSION:-desktop}" = app ]; then
    WM=""
    for w in openbox xfwm4 marco metacity; do command -v $w >/dev/null && WM=$w && break; done
    APP="${SPIROS_APP:-x-terminal-emulator}"
    command -v "${APP%% *}" >/dev/null || APP=x-terminal-emulator
    exec dbus-launch --exit-with-session sh -c "${WM:+$WM &} exec $APP"
fi

case "$DESKTOP" in
    spiros) exec dbus-launch --exit-with-session openbox-session ;;
    mate) exec dbus-launch --exit-with-session mate-session ;;
    cinnamon) exec dbus-launch --exit-with-session cinnamon-session --session cinnamon ;;
    *) exec dbus-launch --exit-with-session xfce4-session ;;
esac
