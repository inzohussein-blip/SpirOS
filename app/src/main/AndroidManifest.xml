<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only apps signed with the SpirOS key: SpirOS and the SpirOS Engine. -->
    <permission
        android:name="com.spiros.app.permission.ENGINE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.spiros.app.permission.ENGINE" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Install the SpirOS Engine (Linux + AI helper) from SpirOS's own release. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lab downloads and guest network, Shield list updates and DNS forwarding, private browser. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Fallback path when the space cannot uninstall an app silently. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Control notification while Linux / AI / Lab run (keeps them alive in the background). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility: list launchable apps in the main profile and in the space. -->
    <queries>
        <!-- The SpirOS Engine (Linux + private AI helper). -->
        <package android:name="com.spiros.app.engine" />
        <!-- Recognise the admin app of an existing work profile. -->
        <package android:name="net.typeblog.shelter" />
        <package android:name="com.oasisfeng.island" />
        <package android:name="com.oasisfeng.island.fdroid" />
        <package android:name="com.google.android.apps.work.clouddpc" />
        <package android:name="com.microsoft.windowsintune.companyportal" />
        <package android:name="com.airwatch.androidagent" />
        <package android:name="com.mobileiron" />
        <package android:name="com.samsung.android.knox.containercore" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SpirApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpirOS">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- Launcher entry as an alias so the copy inside the space can hide its icon. -->
        <activity-alias
            android:name=".Launcher"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Disguise mode: a working calculator icon replaces the SpirOS icon. -->
        <activity-alias
            android:name=".Calculator"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_calculator"
            android:label="@string/disguise_label"
            android:roundIcon="@mipmap/ic_calculator"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- ===== Isolated space (Work Profile, SpirOS as Profile Owner) ===== -->

        <receiver
            android:name=".space.SpaceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".space.ProvisioningModeActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".space.PolicyComplianceActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Runs inside the space; reached from the main profile through a cross-profile
             intent filter. Disabled in the main profile, guarded by a shared token. -->
        <activity
            android:name=".space.SpaceCommandActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.spiros.app.action.SPACE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".space.UninstallResultReceiver"
            android:exported="false" />

        <!-- ===== Security: control notification and Panic tile ===== -->
        <service
            android:name=".security.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's local Linux desktop, on-device AI model or virtual machine running while SpirOS is in the background, with Freeze/Stop/Panic controls." />
        </service>
        <service
            android:name=".security.PanicTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_panic"
            android:label="@string/tile_panic"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".remote.EngineInstallReceiver"
            android:exported="false" />

        <!-- ===== Shield: local DNS-only VPN ===== -->
        <service
            android:name=".shield.ShieldTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_shield"
            android:label="@string/tile_shield"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".shield.ShieldVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>
    </application>

</manifest>
