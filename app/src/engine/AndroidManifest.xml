<?xml version="1.0" encoding="utf-8"?>
<!--
  SpirOS Engine: headless helper that runs Linux (proot) and the private AI for SpirOS.
  It targets API 28 (like Termux) because Android only lets such apps run programs
  from their own storage. It has no icon, no activity and no secrets; everything it
  had from the shared manifest that belongs to the main app is removed here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The engine never installs or removes apps and has no biometric lock. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_PROFILES" tools:node="remove" />

    <application
        android:name="com.spiros.app.remote.EngineApp"
        android:label="@string/engine_name"
        tools:replace="android:name,android:label">

        <!-- Main-app components that must not exist in the engine. -->
        <activity android:name="com.spiros.app.MainActivity" tools:node="remove" />
        <activity-alias android:name="com.spiros.app.Launcher" tools:node="remove" />
        <activity-alias android:name="com.spiros.app.Calculator" tools:node="remove" />
        <receiver android:name="com.spiros.app.space.SpaceAdminReceiver" tools:node="remove" />
        <activity android:name="com.spiros.app.space.ProvisioningModeActivity" tools:node="remove" />
        <activity android:name="com.spiros.app.space.PolicyComplianceActivity" tools:node="remove" />
        <activity android:name="com.spiros.app.space.SpaceCommandActivity" tools:node="remove" />
        <receiver android:name="com.spiros.app.space.UninstallResultReceiver" tools:node="remove" />
        <receiver android:name="com.spiros.app.space.SpaceRepairReceiver" tools:node="remove" />
        <service android:name="com.spiros.app.security.SessionService" tools:node="remove" />
        <service android:name="com.spiros.app.security.PanicTileService" tools:node="remove" />
        <receiver android:name="com.spiros.app.remote.EngineInstallReceiver" tools:node="remove" />
        <service android:name="com.spiros.app.shield.ShieldTileService" tools:node="remove" />
        <service android:name="com.spiros.app.shield.ShieldVpnService" tools:node="remove" />

        <service
            android:name="com.spiros.app.remote.EngineService"
            android:exported="true"
            android:permission="com.spiros.app.permission.ENGINE" />
        <service
            android:name="com.spiros.app.remote.EngineKeepAlive"
            android:exported="false" />
        <!-- Asks Android (for the engine itself) to run it without battery limits;
             opened by SpirOS only (signature permission). No screen of its own. -->
        <activity
            android:name="com.spiros.app.remote.EngineBatteryActivity"
            android:exported="true"
            android:permission="com.spiros.app.permission.ENGINE"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
