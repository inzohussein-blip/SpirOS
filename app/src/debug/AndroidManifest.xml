<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Started from adb by CI (tools/lab_device_test.sh); the DUMP
     permission means only the shell (adb), never another app, can start it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".LabSelfTestActivity"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <activity
            android:name=".LinuxSelfTestActivity"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
